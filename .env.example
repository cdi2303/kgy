# Copy to .env and adjust. PoC reads process.env with safe defaults,
# so .env is optional for local runs.

# HTTP port
PORT=3000

# Public base URL used to build ping URLs shown in the dashboard
BASE_URL=http://localhost:3000

# Background worker scan interval (seconds)
WORKER_INTERVAL_SECONDS=15

# SQLite file path (relative to project root)
DB_PATH=data/cronwatch.sqlite
